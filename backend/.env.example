# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/personal-finance

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# WhatsApp (Baileys session storage)
WHATSAPP_SESSIONS_DIR=./whatsapp-sessions

# Google Contacts (People API / OAuth)
# Create an OAuth 2.0 Client ID in Google Cloud Console and enable People API.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
FRONTEND_URL=http://localhost:3000

# TickTick Open API (OAuth)
# Create an app at https://developer.ticktick.com/manage
# Scopes: tasks:read tasks:write
# OAuth redirect URI must match TICKTICK_REDIRECT_URI.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:3001/api/ticktick/callback
