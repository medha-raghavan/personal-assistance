# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/personal-finance

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# WhatsApp (Baileys session storage)
WHATSAPP_SESSIONS_DIR=./whatsapp-sessions

# Google Contacts (People API / OAuth)
# Create an OAuth 2.0 Client ID in Google Cloud Console and enable People API.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
FRONTEND_URL=http://localhost:3000

# Monthly database backup (emailed on the 1st of each month by default)
BACKUP_ENABLED=true
BACKUP_DIR=./backups
# Cron: minute hour day-of-month month day-of-week
BACKUP_CRON=0 0 1 * *
BACKUP_EMAIL_TO=you@example.com
BACKUP_EMAIL_FROM=backups@example.com
BACKUP_EMAIL_SUBJECT=Personal Finance — Monthly Database Backup

# SMTP settings used to send the backup email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
